<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Spock.AppKit</RootNamespace>
    <AssemblyName>Spock.AppKit</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Spock</Authors>
    <Copyright>Copyright (c) 2026 Spock</Copyright>
    <Description>Shared plumbing for Spock's WPF apps: themes and control styles, a tray icon, crash logging, update checks, window memory, console logging for command-line modes.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
