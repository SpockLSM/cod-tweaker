<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CoDTweaker</AssemblyName>
    <RootNamespace>CoDTweaker</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>CoD Tweaker</Product>
    <Authors>Logan Miller</Authors>
    <Copyright>Copyright (c) 2026 Logan Miller</Copyright>
    <Description>Edit Call of Duty's settings files outside the game.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
