<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CoDTweaker</AssemblyName>
    <RootNamespace>CoDTweaker</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.4.0</Version>
    <Product>CoD Tweaker</Product>
    <Authors>Spock</Authors>
    <Copyright>Copyright (c) 2026 Spock</Copyright>
    <Description>Edit Call of Duty's settings files outside the game.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plumbing shared with CoD Dedupe, vendored from github.com/SpockLSM/appkit with git subtree. -->
    <ProjectReference Include="..\..\shared\appkit\src\Spock.AppKit\Spock.AppKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\notes.json" />
  </ItemGroup>

</Project>
