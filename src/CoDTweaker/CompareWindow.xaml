<Window x:Class="CoDTweaker.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare" Width="960" Height="640" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Text}" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock Text="Compare this file with:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <Button DockPanel.Dock="Right" Content="A preset..." Command="{Binding PickPresetCommand}" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Another file..." Command="{Binding PickFileCommand}" Margin="8,0,0,0"/>
            <ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" MinWidth="240" MaxWidth="360" HorizontalAlignment="Left"
                      ToolTip="Backups this app made of this file, newest first">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Time, StringFormat='Backup from {0:ddd d MMM yyyy, HH:mm:ss}'}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding Summary}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,10"/>

        <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <ListView ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="4">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Setting" Width="280" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Section" Width="120" DisplayMemberBinding="{Binding Section}"/>
                            <GridViewColumn Header="This file" Width="190" DisplayMemberBinding="{Binding Mine.Value}"/>
                            <GridViewColumn Header="Other" Width="190" DisplayMemberBinding="{Binding Theirs}"/>
                            <GridViewColumn Header="" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding TakeText}" Command="{Binding TakeCommand}" Padding="10,3" FontSize="12" MinWidth="80"
                                                ToolTip="Use the other side's value here (becomes a pending change)"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Text="No differences. Every setting that exists on both sides has the same value."
                           Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           Visibility="{Binding HasRows, Converter={StaticResource BoolVisInverse}}"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Take all" Command="{Binding TakeAllCommand}" Margin="0,0,8,0" ToolTip="Use every value from the other side"/>
                <Button Content="Close" IsCancel="True" Style="{StaticResource PrimaryButton}" MinWidth="100"/>
            </StackPanel>
            <TextBlock Text="Taken values become pending changes in the main window. Nothing is written until you click Save there."
                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
